# ---- ThingWorx gateway (same concept as dashboard_log_inv_mgmt: POST {URL}/Thingworx/Things/{THING_NAME}/Services/{SERVICE_NAME}) ----
# Host only - no port unless the server really needs one (the HALO server answers on port 80)
THINGWORX_URL=http://your-thingworx-host
THINGWORX_APPKEY=your-app-key
THINGWORX_VERIFY_SSL=true
THINGWORX_TIMEOUT=60

THING_NAME=L42_Read_HALO
SERVICE_NAME=RunQueryAndGetJSON
# Tried in order when THING_NAME fails (e.g. missing grants). Comma separated, both variables are merged.
HALOD_FALLBACK_THING_NAME=HMG.HALODDBConnection.SQLThing
HALO_FALLBACK_THING_NAME=HMG.HALODDBConnection.SQLThing
# Name of the service's SQL input parameter
THINGWORX_QUERY_PARAM=query
# Rows the service returns per call (RunQueryAndGetJSON caps at 500); more are fetched with ROWNUM paging
TWX_MAX_ROWS=500

# ---- Query behaviour ----
# Page size of the result grid: rows fetched per batch; scrolling to the end loads the next MAX_ROWS rows (no overall limit)
MAX_ROWS=500

# ---- Export (right-click the grid) ----
# Where CSV / SQL INSERT exports are written (on the machine running this app). Exports always fetch ALL rows.
EXPORT_DIR=C:\temp
# DATE/TIMESTAMP columns arrive as epoch ms in ThingWorx's timezone; the app detects the offset to the database
# clock automatically. Only set this (in hours, e.g. 8) if you need to force it.
TWX_TZ_OFFSET_HOURS=

# ---- Object browser ----
# Optional: only show these owners/schemas (comma separated). Empty = all except EXCLUDE_OWNERS
INCLUDE_OWNERS=
EXCLUDE_OWNERS=SYS,SYSCAT,SYSGIS,OUTLN,TBGIS,TIBERO,TIBERO1,SYSTEM
# Also list views (DBA_VIEWS) next to tables (DBA_TABLES)
INCLUDE_VIEWS=false

# ---- Web app ----
APP_HOST=127.0.0.1
APP_PORT=5000
